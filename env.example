DATABASE_URL=postgres://capture:capture@postgres:5432/captures?sslmode=disable
DOWNSTREAM_URL=http://downstream:8081/v1/deliveries
HTTP_ADDR=:8080
STORAGE_DIR=/var/lib/captures/images
MAX_BODY_BYTES=11534336
MAX_IMAGE_BYTES=10485760
WORKER_POLL_INTERVAL=500ms
WORKER_LEASE=30s
DOWNSTREAM_TIMEOUT=10s
RETRY_BASE=1s
RETRY_CEILING=60s
MAX_ATTEMPTS=6
